{
  "manifest_version": 3,
  "name": "My New Tab",
  "version": "2.1.0",
  "description": "A calm new tab: quick links, a command palette that does sums, weather, tasks, habits, countdowns, notes and a focus timer.",
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "permissions": ["storage", "unlimitedStorage", "favicon"],
  "optional_permissions": ["tabs", "bookmarks", "history", "topSites"],
  "host_permissions": [
    "https://picsum.photos/*",
    "https://fastly.picsum.photos/*",
    "https://api.open-meteo.com/*",
    "https://geocoding-api.open-meteo.com/*"
  ]
}
