{
  "manifest_version": 3,
  "name": "My New Tab",
  "version": "2.2.0",
  "description": "A calm new tab: a command palette that does sums, your calendar and weather, tasks, habits, countdowns, and a pause before the sites that eat your day.",
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "permissions": ["storage", "unlimitedStorage", "favicon", "alarms"],
  "background": {
    "service_worker": "worker.js",
    "type": "module"
  },
  "optional_permissions": ["tabs", "bookmarks", "history", "topSites"],
  "host_permissions": [
    "https://picsum.photos/*",
    "https://fastly.picsum.photos/*",
    "https://calendar.google.com/*",
    "https://api.open-meteo.com/*",
    "https://geocoding-api.open-meteo.com/*"
  ]
}
